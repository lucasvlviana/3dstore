# Copie para .env.local e preencha. Na Vercel: Settings > Environment Variables.

# WhatsApp da loja: 55 + DDD + número, só dígitos (ex: 5531999999999)
NEXT_PUBLIC_WHATSAPP=5531999999999

# Instagram sem o @
NEXT_PUBLIC_INSTAGRAM=figureshopbr

# URL final do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://figureshop.com.br
